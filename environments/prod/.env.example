# Google Contacts MCP Server: VPS Production Environment
# Copy this file to /app/data/google-contacts/.env and fill in the values.

# Server configuration
HOST=0.0.0.0
PORT=8080
BASE_URL=https://contacts.mcp.scm-platform.org

# HashiCorp Vault (primary credential source on VPS)
# Required: Vault address and token for loading Google OAuth credentials
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=credentials/google-credentials

# GCP Secret Manager (optional, kept for backward compatibility)
SECRET_NAME=
SECRET_PROJECT=

# Local credential file (optional fallback)
CREDENTIAL_FILE=
